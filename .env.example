# Email delivery for the consultation forms (https://resend.com — free tier is enough)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# Once svraesthetics.co.uk is verified in Resend, use a real sender address:
LEAD_FROM="SVR Aesthetics Website <bookings@svraesthetics.co.uk>"
# Comma-separated inboxes that receive every lead
LEAD_RECIPIENTS=Svraesthetics@gmail.com,Ahmadmumtazprofessional@gmail.com,svraesthetics84@gmail.com

# Tracking (optional — leave blank to disable)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GADS_CONVERSION_LABEL=xxxxxxxxxxx

# n8n webhook that triggers the Vapi outbound calling agent for new leads
# (optional — leave blank to disable; every lead form already funnels through /api/lead)
N8N_OUTBOUND_LEAD_WEBHOOK_URL=https://your-n8n-host/webhook/svr-new-lead
